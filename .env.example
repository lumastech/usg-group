APP_NAME=USGROUP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lusaka

ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=
APP_URL=http://localhost:8000

# Off everywhere real money is held. On, a sign-up at /register also registers the
# person into the current cycle, so a dry run can start from a fresh account. It
# grants no exemption: the cycle's registration window and joining fee tier still
# apply. Pair it with `php artisan unity:open-for-testing`, and close both after.
UNITY_OPEN_REGISTRATION=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usg
DB_USERNAME=usg
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments — Lenco (see docs/LENCO-PAYMENTS-PLAN.md)
#
# Leave PAYMENT_GATEWAY as "null" and nothing calls out: every screen, job and
# ledger path still works and what would have moved is written to the log.
# Switching to "lenco" is the whole go-live change.
#
# LENCO_API_TOKEN moves money out of the group's account. Server environment
# only — never in version control, never shared to the browser. Rotate it
# through support@lenco.co if it is ever exposed.
PAYMENT_GATEWAY=null
LENCO_BASE_URL=https://api.lenco.co/access/v2
LENCO_API_TOKEN=
LENCO_PUBLIC_KEY=
LENCO_ACCOUNT_ID=
LENCO_WIDGET_URL=https://pay.lenco.co/js/v1/inline.js

# The member bears the fee on money coming in, so a K500 contribution reaches
# the savings ledger as exactly K500.
LENCO_COLLECTION_BEARER=customer

# Must differ between sandbox and live, so a test reference can never collide
# with a real one.
PAYMENT_REFERENCE_PREFIX=usg
